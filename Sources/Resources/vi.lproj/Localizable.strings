"whatsNew.v100.baseline.detail" = "Hôm nay được so với ngày tốt nhất của bạn trong ba mươi ngày, tháng này so với cùng kỳ tháng trước, toàn thời gian so với cột mốc tiếp theo. Mỗi thẻ đều ghi rõ đang so với gì. Vòng đầy nghĩa là bạn đã vượt kỷ lục của chính mình — không bao giờ là cảnh báo, và ở đây không có gì bị cạn.";
"whatsNew.v100.baseline.title" = "Mỗi cung đều có ý nghĩa";
"whatsNew.v100.headline" = "Mỗi gói đã hoàn vốn bao nhiêu, nhìn là thấy";
"whatsNew.v100.local.detail" = "tokscale được đóng gói sẵn trong ứng dụng (MIT) — không Homebrew, không npm, không node. Hoàn toàn cục bộ: không bao giờ mở Chuỗi khóa, không hỏi mật khẩu, và không có gì rời khỏi máy Mac này.";
"whatsNew.v100.local.title" = "Không cần cài gì, không gửi gì đi đâu";
"whatsNew.v100.makers.detail" = "Cùng một mô hình dùng qua nhiều đường khác nhau được gộp thành một dòng, Qwen chạy cục bộ vẫn tính là Qwen, và GLM trả theo gói không còn bị ghi nhầm cho hãng khác.";
"whatsNew.v100.makers.title" = "Tính theo hãng làm ra mô hình";
"whatsNew.v100.payback.detail" = "Cho TokNotch biết gói giá bao nhiêu và gia hạn ngày nào, thẻ của gói sẽ cho thấy mức sử dụng của bạn đã bù lại bao nhiêu lần — hoàn vốn 13,4×, hoặc còn thiếu 18 $. Định giá theo chi phí của cùng khối lượng công việc ở mức giá API công bố, và tính theo kỳ thanh toán thật thay vì tháng dương lịch.";
"whatsNew.v100.payback.title" = "Gói đã tự hoàn vốn chưa?";
"whatsNew.v100.rings.detail" = "Ba vòng nằm ở mép màn hình. Bên dưới mỗi vòng là số token; di tới một vòng, thẻ sẽ hiện giá trị tương đương, tỷ lệ đầu vào và đầu ra, số yêu cầu và các mô hình dùng nhiều nhất.";
"whatsNew.v100.rings.title" = "Hôm nay · Tháng này · Toàn thời gian";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen và các hãng khác — mỗi hãng một vòng, tất cả đều tắt cho tới khi bạn bật. Danh sách lập từ những gì máy Mac này thực sự đã dùng, nên hãng bạn chưa từng dùng sẽ không bao giờ xuất hiện.";
"whatsNew.v100.vendors.title" = "Mỗi nhà cung cấp một vòng, chỉ khi đáng có";
