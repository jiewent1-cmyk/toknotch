"whatsNew.title" = "Co nowego";
"whatsNew.v100.baseline.detail" = "Dziś porównywane jest z Twoim najlepszym dniem z trzydziestu, ten miesiąc z tymi samymi dniami zeszłego miesiąca, a łącznie z następnym progiem. Każda karta mówi, z czym porównuje. Pełny pierścień oznacza, że pobiłeś własny rekord — nigdy ostrzeżenie, i nic tu się nie kończy.";
"whatsNew.v100.baseline.title" = "Łuki coś znaczą";
"whatsNew.v100.headline" = "Ile zwrócił każdy plan, na pierwszy rzut oka";
"whatsNew.v100.local.detail" = "tokscale jest wbudowany w aplikację (MIT) — bez Homebrew, bez npm, bez node. Całkowicie lokalnie: nigdy nie otwiera pęku kluczy, nigdy nie pyta o hasło i nic nie opuszcza tego Maca.";
"whatsNew.v100.local.title" = "Nic do instalowania, nic nigdzie nie wysyła";
"whatsNew.v100.makers.detail" = "Ten sam model osiągnięty różnymi drogami staje się jednym wierszem, lokalnie uruchomiony Qwen wciąż liczy się jako Qwen, a GLM z planu nie jest już przypisywany komuś innemu.";
"whatsNew.v100.makers.title" = "Liczone według twórcy modelu";
"whatsNew.v100.payback.detail" = "Powiedz TokNotch, ile kosztuje plan i kiedy się odnawia, a jego karta pokaże, ile razy Twoje użycie go zwróciło — zwrot 13,4×, albo brakuje 18 $. Wyceniane według tego, ile ta sama praca kosztowałaby po opublikowanych stawkach API, i liczone według prawdziwego okresu rozliczeniowego zamiast miesiąca kalendarzowego.";
"whatsNew.v100.payback.title" = "Czy plan się zwrócił?";
"whatsNew.v100.rings.detail" = "Trzy pierścienie, które zostają przy krawędzi ekranu. Pod każdym jest liczba tokenów; sięgnij do jednego, a karta pokaże równowartość, podział na wejście i wyjście, liczbę zapytań i najczęściej używane modele.";
"whatsNew.v100.rings.title" = "Dziś · Ten miesiąc · Łącznie";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen i reszta — po jednym pierścieniu, wszystkie wyłączone, dopóki o nie nie poprosisz. Lista powstaje z tego, czego ten Mac naprawdę używał, więc firma, z której nigdy nie korzystałeś, się nie pojawi.";
"whatsNew.v100.vendors.title" = "Pierścień na dostawcę, tylko tam, gdzie ma sens";
"whatsNew.v110.headline" = "Sam dba o aktualność i mówi Twoim językiem";
"whatsNew.v110.icon.detail" = "Ikona aplikacji ma teraz ciemną lub jasną ramkę. Wybierz tę, która Ci się podoba, w sekcji Ustawienia.";
"whatsNew.v110.icon.title" = "Wybierz ikonę";
"whatsNew.v110.languages.detail" = "Arabski, włoski, niderlandzki, polski, portugalski brazylijski, turecki i wietnamski dołączają do dziewięciu dotychczasowych języków, a każdy zapisuje liczby, kwoty i daty po swojemu.";
"whatsNew.v110.languages.title" = "Szesnaście języków";
"whatsNew.v110.simpler.detail" = "TokNotch uruchamia się teraz sam razem z Makiem, a ustawienia odzywają się tylko wtedy, gdy coś wymaga Twojej uwagi.";
"whatsNew.v110.simpler.title" = "Mniej do ustawiania";
"whatsNew.v110.updates.detail" = "TokNotch sam sprawdza teraz nowe wersje i instaluje je na miejscu, podpisane i poświadczone przez Apple, więc liczby nadążają za narzędziami, których używasz.";
"whatsNew.v110.updates.title" = "Uaktualnienia przychodzą same";
"whatsNew.v120.headline" = "Zwrot w jednym spojrzeniu, mniej do ustawiania";
"whatsNew.v120.menuBar.detail" = "TokNotch nie zajmuje już miejsca w Docku. Ikona na pasku menu pokazuje zwrot w bieżącym okresie i dzisiejsze tokeny w jednym spojrzeniu.";
"whatsNew.v120.menuBar.title" = "Mieszka na pasku menu";
"whatsNew.v120.payback.detail" = "Każdy dostawca zajmuje jeden wiersz: plan, dzień odnowienia, krotność i przełącznik pierścienia. Szczegóły, takie jak własna cena, pojawiają się tylko wtedy, gdy są potrzebne.";
"whatsNew.v120.payback.title" = "Zwrot na jednej stronie";
"whatsNew.v120.simpler.detail" = "Ustawienia to teraz jedna strona z notchem, językiem i ikoną. Tryb ukrycia zniknął, więc notch jest zawsze pod ręką.";
"whatsNew.v120.simpler.title" = "Mniej wyborów";
"whatsNew.v121.about.detail" = "Otwórz je z paska menu lub z numeru wersji w ustawieniach, aby zobaczyć ikonę w pełnym rozmiarze.";
