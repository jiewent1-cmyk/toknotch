"whatsNew.title" = "Novità";
"whatsNew.v100.baseline.detail" = "Oggi si misura rispetto al tuo giorno migliore in trenta, questo mese rispetto agli stessi giorni del mese scorso, da sempre rispetto al prossimo traguardo. Ogni scheda dice con cosa si confronta. Un anello pieno significa che hai battuto il tuo record — mai un avviso, e qui non c’è niente che si esaurisca.";
"whatsNew.v100.baseline.title" = "Gli archi hanno un significato";
"whatsNew.v100.headline" = "Quanto ha ripagato ogni piano, a colpo d’occhio";
"whatsNew.v100.local.detail" = "tokscale è incluso nell’app (MIT) — niente Homebrew, niente npm, niente node. Tutto in locale: non apre mai il portachiavi, non chiede mai una password, e nulla lascia questo Mac.";
"whatsNew.v100.local.title" = "Niente da installare, niente inviato altrove";
"whatsNew.v100.makers.detail" = "Lo stesso modello raggiunto per strade diverse diventa una sola riga, un Qwen eseguito in locale conta comunque come Qwen, e un GLM pagato con un piano non viene più attribuito a qualcun altro.";
"whatsNew.v100.makers.title" = "Contati per chi ha creato il modello";
"whatsNew.v100.payback.detail" = "Di’ a TokNotch quanto costa un piano e quando si rinnova, e la sua scheda mostra quante volte il tuo utilizzo lo ha ripagato — ripagato 13,4×, oppure mancano 18 $. Valutato a quanto sarebbe costato lo stesso lavoro alle tariffe API pubblicate, e contato sul vero periodo di fatturazione invece che sul mese di calendario.";
"whatsNew.v100.payback.title" = "Il piano si è ripagato?";
"whatsNew.v100.rings.detail" = "Tre anelli che restano sul bordo dello schermo. Sotto ciascuno c’è il numero di token; avvicinati a uno e la scheda mostra il valore equivalente, la ripartizione tra input e output, quante richieste e i modelli più usati.";
"whatsNew.v100.rings.title" = "Oggi · Questo mese · Da sempre";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen e gli altri — un anello ciascuno, tutti spenti finché non li chiedi. L’elenco nasce da ciò che questo Mac ha davvero eseguito, quindi un’azienda che non hai mai usato non compare mai.";
"whatsNew.v100.vendors.title" = "Un anello per fornitore, solo dove serve";
"whatsNew.v110.headline" = "Si tiene aggiornato da solo e parla la tua lingua";
"whatsNew.v110.icon.detail" = "L’icona dell’app ora ha una cornice scura o chiara. Scegli quella che preferisci in Impostazioni.";
"whatsNew.v110.icon.title" = "Scegli la tua icona";
"whatsNew.v110.languages.detail" = "Arabo, italiano, olandese, polacco, portoghese brasiliano, turco e vietnamita si aggiungono alle nove lingue già presenti, ognuna con il suo modo di scrivere numeri, importi e date.";
"whatsNew.v110.languages.title" = "Sedici lingue";
"whatsNew.v110.simpler.detail" = "TokNotch ora si apre da solo con il Mac, e le impostazioni si fanno sentire solo quando serve il tuo intervento.";
"whatsNew.v110.simpler.title" = "Meno cose da impostare";
"whatsNew.v110.updates.detail" = "TokNotch ora cerca da solo le nuove versioni e le installa sul posto, firmate e autenticate da Apple, così i numeri restano al passo con gli strumenti che usi.";
"whatsNew.v110.updates.title" = "Gli aggiornamenti arrivano da soli";
"whatsNew.v120.headline" = "Il rientro a colpo d’occhio, meno da impostare";
"whatsNew.v120.menuBar.detail" = "TokNotch non occupa più spazio nel Dock. L’icona nella barra dei menu mostra il rientro del periodo e i token di oggi a colpo d’occhio.";
"whatsNew.v120.menuBar.title" = "Vive nella barra dei menu";
"whatsNew.v120.payback.detail" = "Ogni fornitore sta su una riga con piano, giorno di rinnovo, multiplo e interruttore dell’anello. I dettagli come un prezzo personalizzato compaiono solo quando servono.";
"whatsNew.v120.payback.title" = "Il rientro in una pagina";
"whatsNew.v120.simpler.detail" = "Le impostazioni sono ora una sola pagina per notch, lingua e icona. La modalità nascosta non c’è più, così il notch è sempre a portata di mano.";
"whatsNew.v120.simpler.title" = "Meno scelte da fare";
"whatsNew.v121.about.detail" = "Aprila dalla barra dei menu o dalla versione nelle impostazioni per vedere l’icona a grandezza piena.";
"whatsNew.v121.about.title" = "Una finestra Informazioni";
"whatsNew.v121.colours.detail" = "Il multiplo di rientro ora usa il colore del fornitore, così Claude e OpenAI non si somigliano più.";
"whatsNew.v121.colours.title" = "Ogni fornitore con il suo colore";
"whatsNew.v121.fold.title" = "L’arco delle impostazioni si richiude con il notch";
"whatsNew.v121.headline" = "I dettagli, fatti bene";
"whatsNew.v122.headline" = "Scopri le altre app";
"whatsNew.v122.more.detail" = "In fondo alle impostazioni ora trovi le altre app di Reff Wu, da ottenere o aprire.";
"whatsNew.v122.more.title" = "Altro da Reff Wu";
"whatsNew.v123.antigravity.detail" = "TokNotch ora sincronizza Antigravity ogni pochi minuti, così l’uso di Gemini non resta più fermo.";
"whatsNew.v123.antigravity.title" = "L’uso di Antigravity resta aggiornato";
"whatsNew.v123.headline" = "Ogni strumento sempre aggiornato";
"whatsNew.v123.tokscale.title" = "Basato su tokscale 4.16";
"whatsNew.v124.headline" = "Gli aggiornamenti pensano a tutto";
"whatsNew.v124.updates.detail" = "Le nuove versioni ora si scaricano e si installano da sole, senza richieste da confermare. Preferisci decidere tu? Disattivalo nelle impostazioni.";
"whatsNew.v124.updates.title" = "Installati per te";
"whatsNew.v125.headline" = "WorkBuddy torna nel conteggio";
"whatsNew.v125.workbuddy.detail" = "WorkBuddy AI 5.5 ha spostato le sessioni in una nuova cartella, quindi i suoi token mancavano. Ora TokNotch li legge da lì.";
"whatsNew.v125.workbuddy.title" = "L’uso di WorkBuddy compare";
"whatsNew.v126.dock.detail" = "Per impostazione predefinita TokNotch resta fuori dal Dock. Attiva «Mostra nel Dock» nelle impostazioni per tenerlo lì.";
"whatsNew.v126.dock.title" = "Nel Dock, se vuoi";
"whatsNew.v126.headline" = "La barra dei menu, ridisegnata";
"whatsNew.v126.panel.detail" = "Fai clic sull’icona nella barra dei menu per vedere quante volte si sono ripagati i tuoi piani, oggi, questo mese e in totale affiancati, e ogni piano sulla sua riga. Controlla aggiornamenti ed Esci sono sempre in fondo.";
"whatsNew.v126.panel.title" = "Tutto a colpo d’occhio";
"whatsNew.v127.headline" = "Una barra dei menu più ordinata";
"whatsNew.v127.menuBar.detail" = "Se la barra dei menu è affollata, disattiva «Mostra nella barra dei menu» nelle impostazioni. Il notch resta al suo posto e riaprendo TokNotch tornano le impostazioni.";
"whatsNew.v127.menuBar.title" = "Nascondi l’icona nella barra dei menu";
"whatsNew.v128.headline" = "Un’unica icona";
"whatsNew.v128.icon.detail" = "TokNotch ora usa sempre l’icona con la cornice scura, quindi l’impostazione «Icona dell’app» non c’è più. Se avevi scelto quella chiara, torna da sola.";
"whatsNew.v128.icon.title" = "Cornice scura ovunque";
"whatsNew.v130.alignment.detail" = "Sui monitor esterni senza notch, la pillola e il pannello aderiscono perfettamente al bordo superiore.";
"whatsNew.v130.alignment.title" = "Bordo superiore continuo";
"whatsNew.v130.experience.detail" = "Nuova schermata delle novità, icona incisa ad alto contrasto e statistiche anonime opzionali.";
"whatsNew.v130.experience.title" = "Dettagli rifiniti";
"whatsNew.v130.headline" = "Supporto multi-monitor e allineamento superiore";
"whatsNew.v130.multiscreen.detail" = "TokNotch ora appare su tutti gli schermi collegati con anelli di utilizzo sincronizzati.";
"whatsNew.v130.multiscreen.title" = "Tutti i tuoi schermi";
"whatsNew.v131.dsh.detail" = "DSH salva le sessioni come registri compressi e con versione che TokNotch saltava, quindi quasi nulla veniva contato. Ora ogni sessione viene conteggiata.";
