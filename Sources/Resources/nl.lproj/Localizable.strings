"whatsNew.v110.icon.title" = "Kies je symbool";
"whatsNew.v110.languages.detail" = "Arabisch, Italiaans, Nederlands, Pools, Braziliaans Portugees, Turks en Vietnamees komen bij de negen talen die er al waren, elk met een eigen manier om getallen, bedragen en datums te schrijven.";
"whatsNew.v110.languages.title" = "Zestien talen";
"whatsNew.v110.simpler.detail" = "TokNotch opent nu vanzelf met je Mac, en de instellingen melden zich alleen als er iets van je nodig is.";
"whatsNew.v110.simpler.title" = "Minder in te stellen";
"whatsNew.v110.updates.detail" = "TokNotch zoekt nu zelf naar nieuwe versies en installeert ze ter plekke, ondertekend en notarieel bekrachtigd door Apple, zodat de getallen blijven kloppen met je tools.";
"whatsNew.v110.updates.title" = "Updates komen vanzelf";
"whatsNew.v120.headline" = "Terugverdiend in één oogopslag, minder in te stellen";
