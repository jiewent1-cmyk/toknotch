"whatsNew.v100.baseline.detail" = "Vandaag wordt gemeten tegen je beste dag in dertig, deze maand tegen dezelfde dagen vorige maand, altijd tegen de volgende mijlpaal. Elke kaart zegt waarmee hij vergelijkt. Een volle ring betekent dat je je eigen record hebt verbroken — nooit een waarschuwing, en er is hier niets dat opraakt.";
"whatsNew.v100.baseline.title" = "De bogen betekenen iets";
"whatsNew.v100.headline" = "Wat elk abonnement heeft terugverdiend, in één oogopslag";
"whatsNew.v100.local.detail" = "tokscale zit in de app (MIT) — geen Homebrew, geen npm, geen node. Volledig lokaal: het opent nooit de sleutelhanger, vraagt nooit om een wachtwoord en niets verlaat deze Mac.";
"whatsNew.v100.local.title" = "Niets te installeren, niets verstuurd";
"whatsNew.v100.makers.detail" = "Hetzelfde model via verschillende routes wordt één rij, een lokaal gedraaide Qwen telt nog steeds als Qwen, en een GLM uit een abonnement wordt niet meer aan iemand anders toegeschreven.";
"whatsNew.v100.makers.title" = "Geteld naar wie het model maakte";
"whatsNew.v100.payback.detail" = "Vertel TokNotch wat een abonnement kost en wanneer het verlengt, en de kaart toont hoe vaak je gebruik het heeft terugverdiend — 13,4× terugverdiend, of nog $ 18 te gaan. Gewaardeerd tegen wat hetzelfde werk had gekost volgens de gepubliceerde API-tarieven, en geteld over de echte factuurperiode in plaats van de kalendermaand.";
"whatsNew.v100.payback.title" = "Heeft het abonnement zichzelf terugverdiend?";
"whatsNew.v100.rings.detail" = "Drie ringen die aan de rand van het scherm blijven. Onder elke ring staat het aantal tokens; ga er naartoe en de kaart toont de gelijkwaardige waarde, de verdeling tussen invoer en uitvoer, het aantal verzoeken en de meest gebruikte modellen.";
"whatsNew.v100.rings.title" = "Vandaag · Deze maand · Altijd";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen en de rest — één ring elk, allemaal uit tot je erom vraagt. De lijst komt van wat deze Mac echt heeft gebruikt, dus een bedrijf dat je nooit hebt gebruikt verschijnt nooit.";
"whatsNew.v100.vendors.title" = "Een ring per aanbieder, alleen waar hij iets zegt";
"whatsNew.v110.headline" = "Houdt zichzelf bij en spreekt jouw taal";
