"whatsNew.continue" = "Fortfahren";
"whatsNew.title" = "Neuerungen";
"whatsNew.v100.baseline.detail" = "Heute misst sich an Ihrem stärksten Tag der letzten dreißig, dieser Monat an denselben Tagen des Vormonats, Gesamt am nächsten Meilenstein. Jede Karte nennt ihren Vergleich. Ein voller Ring heißt: eigener Rekord übertroffen — nie eine Warnung, und hier geht nichts zur Neige.";
"whatsNew.v100.baseline.title" = "Die Bögen bedeuten etwas";
"whatsNew.v100.headline" = "Auf einen Blick: das Wievielfache jedes Abo eingespielt hat";
"whatsNew.v100.local.detail" = "tokscale steckt in der App (MIT) — kein Homebrew, kein npm, kein Node. Vollständig lokal: kein Zugriff auf den Schlüsselbund, keine Passwortabfrage, und nichts verlässt diesen Mac.";
"whatsNew.v100.local.title" = "Nichts zu installieren, nichts geht hinaus";
"whatsNew.v100.makers.detail" = "Dasselbe Modell über verschiedene Wege fällt in eine Zeile zusammen, ein lokal ausgeführtes Qwen bleibt Qwen, und ein über ein Abo abgerechnetes GLM wird niemandem sonst gutgeschrieben.";
"whatsNew.v100.makers.title" = "Gezählt nach dem Hersteller des Modells";
"whatsNew.v100.payback.detail" = "Tragen Sie Preis und Abrechnungstag ein, und die Karte zeigt, um das Wievielfache Ihre Nutzung das Abo zurückgezahlt hat — 13,4× eingespielt oder noch 18 $ bis dahin. Bewertet zu den veröffentlichten API-Preisen und über den tatsächlichen Abrechnungszeitraum gerechnet, nicht über den Kalendermonat.";
"whatsNew.v100.payback.title" = "Hat sich das Abo gelohnt?";
"whatsNew.v100.rings.detail" = "Drei Ringe am Bildschirmrand, darunter die Anzahl der Token. Fahren Sie hin, und die Karte zeigt Gegenwert, das Verhältnis von Ein- und Ausgabe, die Anzahl der Anfragen und die meistgenutzten Modelle.";
"whatsNew.v100.rings.title" = "Heute · Dieser Monat · Gesamt";
"whatsNew.v100.vendors.detail" = "Anthropic, OpenAI, DeepSeek, Qwen und die übrigen — je einer, alle zunächst aus. Die Liste entsteht aus dem, was dieser Mac tatsächlich ausgeführt hat; ein nie genutzter Anbieter taucht nie auf.";
"whatsNew.v100.vendors.title" = "Ein Ring je Anbieter, nur wo er verdient ist";
"whatsNew.v110.headline" = "Hält sich selbst aktuell und spricht deine Sprache";
"whatsNew.v110.icon.detail" = "Das App-Symbol gibt es jetzt mit dunklem oder hellem Rahmen. Wähle unter Einstellungen, was dir gefällt.";
"whatsNew.v110.icon.title" = "Such dir dein Symbol aus";
"whatsNew.v110.languages.detail" = "Arabisch, Italienisch, Niederländisch, Polnisch, brasilianisches Portugiesisch, Türkisch und Vietnamesisch kommen zu den bisherigen neun hinzu, jede mit ihrer eigenen Schreibweise für Zahlen, Beträge und Daten.";
"whatsNew.v110.languages.title" = "Sechzehn Sprachen";
"whatsNew.v110.simpler.detail" = "TokNotch startet jetzt von selbst mit deinem Mac, und die Einstellungen melden sich nur, wenn etwas dich braucht.";
"whatsNew.v110.simpler.title" = "Weniger einzustellen";
"whatsNew.v110.updates.detail" = "TokNotch sucht jetzt selbst nach neuen Versionen und installiert sie direkt, von Apple signiert und beglaubigt, damit die Zahlen zu deinen Werkzeugen passen.";
"whatsNew.v110.updates.title" = "Updates kommen von selbst";
"whatsNew.v120.headline" = "Amortisation auf einen Blick, weniger einzustellen";
"whatsNew.v120.menuBar.detail" = "TokNotch belegt keinen Platz mehr im Dock. Das Menüleistensymbol zeigt die Amortisation dieses Zeitraums und die heutigen Tokens auf einen Blick.";
"whatsNew.v120.menuBar.title" = "Zu Hause in der Menüleiste";
"whatsNew.v120.payback.detail" = "Jeder Anbieter steht in einer Zeile mit Abo, Verlängerungstag, Faktor und Ring-Schalter. Details wie ein eigener Preis erscheinen nur, wenn du sie brauchst.";
"whatsNew.v120.payback.title" = "Amortisation auf einer Seite";
"whatsNew.v120.simpler.detail" = "Die Einstellungen sind jetzt eine Seite für Notch, Sprache und Symbol. Der Ausblenden-Modus ist weg, die Notch bleibt immer erreichbar.";
"whatsNew.v120.simpler.title" = "Weniger zu entscheiden";
"whatsNew.v121.about.detail" = "Öffne es über die Menüleiste oder die Version in den Einstellungen, um das Symbol in voller Größe zu sehen.";
"whatsNew.v121.about.title" = "Ein Über-Fenster";
"whatsNew.v121.colours.detail" = "Der Amortisationsfaktor erscheint jetzt in der Farbe des Anbieters, damit Claude und OpenAI nie gleich aussehen.";
"whatsNew.v121.colours.title" = "Jeder Anbieter in seiner Farbe";
"whatsNew.v121.fold.title" = "Der Einstellungsbogen faltet sich mit der Notch ein";
"whatsNew.v121.headline" = "Kleinigkeiten, richtig gemacht";
"whatsNew.v122.headline" = "Lerne die anderen Apps kennen";
"whatsNew.v122.more.detail" = "Unten in den Einstellungen stehen jetzt die anderen Apps von Reff Wu, jeweils zum Laden oder Öffnen.";
"whatsNew.v122.more.title" = "Mehr von Reff Wu";
"whatsNew.v123.antigravity.detail" = "TokNotch synchronisiert Antigravity jetzt alle paar Minuten, damit die Gemini-Nutzung nicht mehr stehen bleibt.";
"whatsNew.v123.antigravity.title" = "Antigravity bleibt aktuell";
"whatsNew.v123.headline" = "Jedes Werkzeug auf dem neuesten Stand";
"whatsNew.v123.tokscale.title" = "Mit tokscale 4.16";
"whatsNew.v124.headline" = "Updates erledigen sich selbst";
"whatsNew.v124.updates.detail" = "Neue Versionen werden jetzt ohne Nachfrage geladen und installiert. Lieber selbst entscheiden? In den Einstellungen abschalten.";
"whatsNew.v124.updates.title" = "Wird für dich installiert";
"whatsNew.v125.headline" = "WorkBuddy zählt wieder mit";
"whatsNew.v125.workbuddy.detail" = "WorkBuddy AI 5.5 speichert Sitzungen in einem neuen Ordner, daher fehlten seine Tokens. TokNotch liest sie jetzt von dort.";
"whatsNew.v125.workbuddy.title" = "WorkBuddy-Nutzung wird erfasst";
"whatsNew.v126.dock.detail" = "TokNotch bleibt standardmäßig aus dem Dock. Schalte in den Einstellungen „Im Dock anzeigen“ ein, um es dort zu behalten.";
"whatsNew.v126.dock.title" = "Auf Wunsch im Dock";
"whatsNew.v126.headline" = "Die Menüleiste, neu gestaltet";
"whatsNew.v126.panel.detail" = "Ein Klick auf das Menüleistensymbol zeigt, wie oft sich deine Abos bezahlt gemacht haben, dazu Heute, Diesen Monat und Gesamt nebeneinander und jedes Abo in einer eigenen Zeile. Nach Updates suchen und Beenden stehen immer unten.";
"whatsNew.v126.panel.title" = "Alles auf einen Blick";
"whatsNew.v127.headline" = "Eine ruhigere Menüleiste";
"whatsNew.v127.menuBar.detail" = "Ist deine Menüleiste voll, schalte in den Einstellungen „In der Menüleiste anzeigen“ aus. Die Notch bleibt, und wenn du TokNotch erneut öffnest, kommen die Einstellungen zurück.";
"whatsNew.v127.menuBar.title" = "Menüleistensymbol ausblenden";
"whatsNew.v128.headline" = "Ein Symbol";
"whatsNew.v128.icon.detail" = "TokNotch verwendet jetzt immer das Symbol mit dunklem Rahmen, daher entfällt die Einstellung „App-Symbol“. Hattest du das helle gewählt, wechselt es von selbst zurück.";
"whatsNew.v128.icon.title" = "Überall der dunkle Rahmen";
"whatsNew.v130.alignment.detail" = "Auf externen Bildschirmen schließen Pille und Bedienfeld bündig mit der oberen Kante ab.";
"whatsNew.v130.alignment.title" = "Bündiger oberer Rand";
"whatsNew.v130.experience.detail" = "Neues Neuerungen-Fenster, kontrastreiches Gravur-Symbol und optionale anonyme Nutzungsdaten.";
"whatsNew.v130.experience.title" = "Verfeinerte Details";
"whatsNew.v130.headline" = "Multi-Display-Unterstützung und bündige Ausrichtung";
"whatsNew.v130.multiscreen.detail" = "TokNotch erscheint auf allen angeschlossenen Displays mit synchronisierten Ringen und Status.";
"whatsNew.v130.multiscreen.title" = "Alle Bildschirme";
"whatsNew.v131.dsh.detail" = "DSH speichert seine Sitzungen als versionierte, komprimierte Protokolle, an denen TokNotch bisher vorbeilas. Jetzt wird jede Sitzung mitgezählt.";
"whatsNew.v131.dsh.title" = "DeepSeek Harness zählt mit";
"whatsNew.v131.headline" = "DeepSeek Harness wird mitgezählt";
"whatsNew.v131.tokscale.detail" = "Zwei Releases voller Korrekturen, darunter die richtige Berechnung einstündiger Cache-Schreibvorgänge in Claude Code und genauere Zahlen für Codex und CherryStudio.";
