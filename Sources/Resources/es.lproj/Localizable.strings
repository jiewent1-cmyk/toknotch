"whatsNew.v110.languages.detail" = "Árabe, italiano, neerlandés, polaco, portugués de Brasil, turco y vietnamita se suman a los nueve que ya había, cada uno escribiendo números, importes y fechas a su manera.";
"whatsNew.v110.languages.title" = "Dieciséis idiomas";
